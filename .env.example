# Required for Docker Compose. Use letters/digits or URL-encode URL-reserved characters.
POSTGRES_PASSWORD=replaceWithALongRandomPassword
# Local defaults; Compose explicitly overrides these variables.
DATABASE_URL=sqlite:///./crease.db
JOB_MODE=local
REDIS_URL=redis://localhost:6379/0
DEMO_SEED=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Provider ingestion is inactive until a source is configured and enabled.
CRICKETDATA_API_KEY=
PROVIDER_DAILY_BUDGET=0
CRICKETDATA_BASE_URL=https://api.cricapi.com/v1
# Default needs no account. RSS headlines may be delayed and omit competition names.
LIVE_FEED_ENABLED=true
LIVE_FEED_PROVIDER=espn_rss
LIVE_FEED_URL=https://static.espncricinfo.com/rss/livescores.xml
LIVE_POLL_SECONDS=120
LIVE_MAX_PAGES=4
# With a private CricketData key and positive budget, switch provider to cricketdata.
# For example, polling every 900 seconds spends 96 calls/day per page,
# before series discovery and qualification-source syncs. Budget is shared.
